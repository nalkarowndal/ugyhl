{
  "name": "pawchive-mobile",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:transport": "bash scripts/test-transfer-core.sh",
    "android:init": "npm run build && npx cap add android && node scripts/install-native-plugin.mjs && npx cap sync android",
    "android:sync": "npm run build && node scripts/install-native-plugin.mjs && npx cap sync android",
    "android:open": "npx cap open android",
    "verify:source": "node scripts/verify-source.cjs",
    "test:url-privacy": "node scripts/test-url-privacy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
